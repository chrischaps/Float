// title.rhai — the opening card: SET + DRIFT over the drifting world.
//
// Two pre-rendered sprites (sprites/title_setdrift.png + title_presskey.png,
// regenerated by tools/generate_title.py — the ASPECT/SUB_REL_W consts below
// must match what it prints). The world is fully alive behind the card — the
// raft heaves, the sky wheels — only look/scoot input is locked, via the
// published `locked` factor that seat_camera.rhai reads (whale/seat
// factor pattern; the one-frame set_field lag is invisible here).
//
// Timeline: title eases in from black-ish, "Press Any Key" follows a
// beat later and breathes on a slow swell. The FIRST raw input after
// min_show_s (any key, mouse button, or pad button — see the engine's
// any_input_just_pressed) unlocks the camera immediately and starts the
// fade-out; when it completes the script goes dormant.

let t = 0.0;          // seconds since load
let dismiss_t = -1.0; // < 0 = still showing; >= 0 = seconds since the keypress
let done = false;
let birds_cued = false; // title flyby one-shot sent to birds.rhai

const TITLE_ASPECT = 0.12237; // title_setdrift.png height/width
const SUB_ASPECT = 0.10606;   // title_presskey.png height/width
const SUB_REL_W = 0.2919;     // presskey natural width / title natural width

fn sstep(t) {
    let c = clamp(t, 0.0, 1.0);
    c * c * (3.0 - 2.0 * c)
}

fn on_update() {
    if done { return; }
    let me = this_entity();

    let enabled = get_field(me, "title", "enabled");
    if enabled == () { return; }   // fields not materialized yet
    if !enabled {
        set_field(me, "title", "locked", 0.0);
        done = true;
        return;
    }

    t += delta_time();

    // Cue the title flyby (birds.rhai title_pass one-shot) a beat in —
    // the flock is ~3 s of flight from the frame edge, so it enters as
    // the title reaches full strength. Birds are world creatures: they
    // keep flying if the card is dismissed mid-crossing.
    if !birds_cued && t >= 0.3 {
        birds_cued = true;
        let bf = get_entity("bird_flock");
        if bf >= 0 { set_field(bf, "birds", "title_pass", true); }
    }

    if dismiss_t < 0.0 {
        if t >= get_field(me, "title", "min_show_s") && any_input_just_pressed() {
            dismiss_t = 0.0;
            // The camera frees the moment the key lands; only the card
            // itself lingers through the fade.
            set_field(me, "title", "locked", 0.0);
        }
    } else {
        dismiss_t += delta_time();
        if dismiss_t >= get_field(me, "title", "fade_out_s") {
            done = true;
        }
    }
}

fn on_draw_ui() {
    if done { return; }
    let me = this_entity();

    let fade_in = get_field(me, "title", "fade_in_s");
    if fade_in == () { return; }
    let sub_delay = get_field(me, "title", "sub_delay_s");
    let fade_out = get_field(me, "title", "fade_out_s");
    let title_frac = get_field(me, "title", "title_frac");

    let scr_w = screen_width();
    let scr_h = screen_height();
    if scr_w <= 0.0 || scr_h <= 0.0 { return; }

    let ease_in = sstep(t / fade_in);
    let sub_in = sstep((t - sub_delay) / fade_in);
    let ease_out = if dismiss_t < 0.0 {
        1.0
    } else {
        1.0 - sstep(dismiss_t / fade_out)
    };
    if ease_out <= 0.0 { return; }

    // One scale factor for both sprites keeps the designed proportion;
    // the title hangs just above center (optical center), the prompt a
    // title-height's breath below it.
    let tw = scr_w * title_frac;
    let th = tw * TITLE_ASPECT;
    let tx = (scr_w - tw) * 0.5;
    let ty = scr_h * 0.40 - th * 0.5;

    let pw = tw * SUB_REL_W;
    let ph = pw * SUB_ASPECT;
    let px = (scr_w - pw) * 0.5;
    let py = ty + th + th * 0.55;

    // The prompt breathes on a swell-slow period so it invites rather
    // than blinks.
    let breath = 0.70 + 0.30 * sin(t * 1.4);

    draw_sprite_ex(tx, ty, tw, th, "title_setdrift.png",
        0.0, 0.0, 1.0, 1.0,
        1.0, 0.99, 0.96, 0.94 * ease_in * ease_out, 10);
    draw_sprite_ex(px, py, pw, ph, "title_presskey.png",
        0.0, 0.0, 1.0, 1.0,
        1.0, 0.99, 0.96, 0.78 * sub_in * breath * ease_out, 10);
}
